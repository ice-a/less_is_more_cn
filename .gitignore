# Cache
# 注意：这些路径带斜杠，会锚定到 .gitignore 所在目录，所以要写全 content 前缀
content/.vitepress/cache
content/.vitepress/dist

# 本地维护脚本（一次性排查工具，不随仓库提交）
scripts/*
# 但 llm.txt 生成脚本是站点构建的一部分，需要入库
!scripts/generate-llm-txt.mjs
# 外链巡检脚本是长期维护工具，需要入库
!scripts/check-links.mjs
# 构建产物与跳转页/llm.txt 一致性校验，需要入库
!scripts/final-verify.mjs
# SEO 推送脚本由 GitHub Actions 的 seo job 调用，需要入库
!scripts/seo-push.mjs

# Package manager files
.yarn-integrity
.pnp.*

# Coverage directory
coverage

# Temporary files
*.tmp
*.temp
